{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "디자인 토큰 원천. Figma Variables에서 동기화한다(figma-sync 스킬). 손으로 수정하지 않는다. semantic.color는 shadcn/React Native Reusables 규약의 평면 이름을 쓰며 값은 {light, dark} 모드 객체다. {primitive.…} 참조를 허용한다. `pnpm tokens:sync`가 tailwind.config.js, global.css, lib/theme.ts를 생성한다.",
  "$modes": ["light", "dark"],
  "$source": {
    "figmaFileKey": "TBD",
    "figmaVariableCollections": ["color/primitive", "color/semantic", "typography", "radius", "size"],
    "pencilFile": "design.pen",
    "lastSyncedAt": null
  },
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "black": { "$type": "color", "$value": "#000000" },
      "slate": {
        "50": { "$type": "color", "$value": "#F8FAFC" },
        "100": { "$type": "color", "$value": "#F1F5F9" },
        "200": { "$type": "color", "$value": "#E2E8F0" },
        "300": { "$type": "color", "$value": "#CBD5E1" },
        "400": { "$type": "color", "$value": "#94A3B8" },
        "500": { "$type": "color", "$value": "#64748B" },
        "600": { "$type": "color", "$value": "#475569" },
        "700": { "$type": "color", "$value": "#334155" },
        "800": { "$type": "color", "$value": "#1E293B" },
        "900": { "$type": "color", "$value": "#0F172A" },
        "950": { "$type": "color", "$value": "#020617" }
      },
      "blue": {
        "50": { "$type": "color", "$value": "#EFF6FF" },
        "100": { "$type": "color", "$value": "#DBEAFE" },
        "400": { "$type": "color", "$value": "#60A5FA" },
        "500": { "$type": "color", "$value": "#3B82F6" },
        "600": { "$type": "color", "$value": "#2563EB" },
        "700": { "$type": "color", "$value": "#1D4ED8" },
        "800": { "$type": "color", "$value": "#1E40AF" },
        "900": { "$type": "color", "$value": "#1E3A8A" },
        "950": { "$type": "color", "$value": "#172554" }
      },
      "gold": {
        "100": { "$type": "color", "$value": "#FEF9C3" },
        "500": { "$type": "color", "$value": "#EAB308" },
        "600": { "$type": "color", "$value": "#CA8A04" },
        "700": { "$type": "color", "$value": "#A16207" },
        "900": { "$type": "color", "$value": "#713F12" }
      },
      "red": {
        "100": { "$type": "color", "$value": "#FEE2E2" },
        "500": { "$type": "color", "$value": "#EF4444" },
        "600": { "$type": "color", "$value": "#DC2626" },
        "900": { "$type": "color", "$value": "#7F1D1D" }
      },
      "green": {
        "100": { "$type": "color", "$value": "#D1FAE5" },
        "500": { "$type": "color", "$value": "#10B981" },
        "600": { "$type": "color", "$value": "#059669" },
        "900": { "$type": "color", "$value": "#064E3B" }
      }
    },
    "fontFamily": {
      "sans": { "$type": "fontFamily", "$value": "Pretendard" }
    },
    "fontWeight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "semantic": {
    "color": {
      "$description": "shadcn 규약: X = 배경, X-foreground = 그 위의 텍스트, X-muted = 옅은 배경(배지·강조 영역). 핀테크 추가: positive(입금·수익), destructive(출금·손실·오류), warning, info, highlight(프리미엄·혜택 골드), inverse(토스트).",
      "background": { "$type": "color", "$value": { "light": "{primitive.color.slate.50}", "dark": "{primitive.color.slate.950}" }, "$description": "화면 최하단 배경" },
      "foreground": { "$type": "color", "$value": { "light": "{primitive.color.slate.900}", "dark": "{primitive.color.slate.50}" }, "$description": "기본 텍스트" },
      "card": { "$type": "color", "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.slate.900}" }, "$description": "카드, 목록 항목" },
      "card-foreground": { "$type": "color", "$value": { "light": "{primitive.color.slate.900}", "dark": "{primitive.color.slate.50}" } },
      "popover": { "$type": "color", "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.slate.800}" }, "$description": "다이얼로그, 바텀시트, 메뉴" },
      "popover-foreground": { "$type": "color", "$value": { "light": "{primitive.color.slate.900}", "dark": "{primitive.color.slate.50}" } },
      "primary": { "$type": "color", "$value": { "light": "{primitive.color.blue.800}", "dark": "{primitive.color.blue.500}" }, "$description": "주요 CTA, 활성 상태, 링크" },
      "primary-foreground": { "$type": "color", "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.white}" } },
      "secondary": { "$type": "color", "$value": { "light": "{primitive.color.slate.100}", "dark": "{primitive.color.slate.800}" }, "$description": "보조 버튼" },
      "secondary-foreground": { "$type": "color", "$value": { "light": "{primitive.color.slate.900}", "dark": "{primitive.color.slate.50}" } },
      "muted": { "$type": "color", "$value": { "light": "{primitive.color.slate.100}", "dark": "{primitive.color.slate.800}" }, "$description": "입력 배경, 스켈레톤, 비활성 영역" },
      "muted-foreground": { "$type": "color", "$value": { "light": "{primitive.color.slate.500}", "dark": "{primitive.color.slate.400}" }, "$description": "보조 설명, 라벨, 플레이스홀더" },
      "accent": { "$type": "color", "$value": { "light": "{primitive.color.blue.50}", "dark": "{primitive.color.blue.950}" }, "$description": "눌림·선택 배경 (ghost/outline 버튼 active)" },
      "accent-foreground": { "$type": "color", "$value": { "light": "{primitive.color.blue.900}", "dark": "{primitive.color.blue.100}" } },
      "destructive": { "$type": "color", "$value": { "light": "{primitive.color.red.600}", "dark": "{primitive.color.red.500}" }, "$description": "출금, 손실, 오류, 파괴적 액션. 색만으로 의미를 전달하지 않는다" },
      "destructive-foreground": { "$type": "color", "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.white}" } },
      "destructive-muted": { "$type": "color", "$value": { "light": "{primitive.color.red.100}", "dark": "{primitive.color.red.900}" }, "$description": "출금·오류 배지 배경" },
      "positive": { "$type": "color", "$value": { "light": "{primitive.color.green.600}", "dark": "{primitive.color.green.500}" }, "$description": "입금, 수익, 성공" },
      "positive-foreground": { "$type": "color", "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.white}" } },
      "positive-muted": { "$type": "color", "$value": { "light": "{primitive.color.green.100}", "dark": "{primitive.color.green.900}" } },
      "warning": { "$type": "color", "$value": { "light": "{primitive.color.gold.700}", "dark": "{primitive.color.gold.500}" } },
      "warning-foreground": { "$type": "color", "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.slate.950}" } },
      "warning-muted": { "$type": "color", "$value": { "light": "{primitive.color.gold.100}", "dark": "{primitive.color.gold.900}" } },
      "info": { "$type": "color", "$value": { "light": "{primitive.color.blue.600}", "dark": "{primitive.color.blue.400}" } },
      "info-foreground": { "$type": "color", "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.slate.950}" } },
      "info-muted": { "$type": "color", "$value": { "light": "{primitive.color.blue.50}", "dark": "{primitive.color.blue.950}" } },
      "highlight": { "$type": "color", "$value": { "light": "{primitive.color.gold.700}", "dark": "{primitive.color.gold.500}" }, "$description": "프리미엄 등급·혜택 강조 골드. 한 화면에 한 곳만" },
      "highlight-foreground": { "$type": "color", "$value": { "light": "{primitive.color.white}", "dark": "{primitive.color.slate.950}" } },
      "inverse": { "$type": "color", "$value": { "light": "{primitive.color.slate.900}", "dark": "{primitive.color.slate.50}" }, "$description": "토스트, 툴팁" },
      "inverse-foreground": { "$type": "color", "$value": { "light": "{primitive.color.slate.50}", "dark": "{primitive.color.slate.900}" } },
      "border": { "$type": "color", "$value": { "light": "{primitive.color.slate.200}", "dark": "{primitive.color.slate.700}" } },
      "input": { "$type": "color", "$value": { "light": "{primitive.color.slate.300}", "dark": "{primitive.color.slate.600}" }, "$description": "입력 필드 테두리" },
      "ring": { "$type": "color", "$value": { "light": "{primitive.color.blue.600}", "dark": "{primitive.color.blue.400}" }, "$description": "포커스 링" }
    },
    "typography": {
      "$description": "fontSize/lineHeight는 pt. 한글 제목은 letterSpacing을 음수로 조인다. 금액·숫자는 반드시 tabular(fontVariant tabular-nums)와 함께 쓴다. Tailwind 기본 크기(text-sm 등)는 유지되며 아래는 추가 토큰이다.",
      "display": { "$type": "typography", "$value": { "fontSize": 32, "lineHeight": 40, "fontWeight": "{primitive.fontWeight.bold}", "letterSpacing": -0.5 }, "$description": "온보딩 헤드라인" },
      "amount-lg": { "$type": "typography", "$value": { "fontSize": 36, "lineHeight": 44, "fontWeight": "{primitive.fontWeight.bold}", "letterSpacing": -0.5, "tabular": true }, "$description": "잔액, 이체 금액 입력" },
      "amount-md": { "$type": "typography", "$value": { "fontSize": 24, "lineHeight": 32, "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": -0.3, "tabular": true }, "$description": "카드 내 잔액" },
      "amount-sm": { "$type": "typography", "$value": { "fontSize": 16, "lineHeight": 24, "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": 0, "tabular": true }, "$description": "거래 목록 금액" },
      "h1": { "$type": "typography", "$value": { "fontSize": 24, "lineHeight": 32, "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": -0.3 }, "$description": "화면 제목" },
      "h2": { "$type": "typography", "$value": { "fontSize": 20, "lineHeight": 28, "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": -0.3 }, "$description": "섹션 제목" },
      "h3": { "$type": "typography", "$value": { "fontSize": 18, "lineHeight": 26, "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": -0.2 }, "$description": "카드 제목" },
      "body-lg": { "$type": "typography", "$value": { "fontSize": 18, "lineHeight": 28, "fontWeight": "{primitive.fontWeight.regular}", "letterSpacing": 0 } },
      "body": { "$type": "typography", "$value": { "fontSize": 16, "lineHeight": 24, "fontWeight": "{primitive.fontWeight.regular}", "letterSpacing": 0 }, "$description": "기본 본문" },
      "body-sm": { "$type": "typography", "$value": { "fontSize": 14, "lineHeight": 20, "fontWeight": "{primitive.fontWeight.regular}", "letterSpacing": 0 }, "$description": "보조 설명" },
      "label": { "$type": "typography", "$value": { "fontSize": 14, "lineHeight": 20, "fontWeight": "{primitive.fontWeight.medium}", "letterSpacing": 0 }, "$description": "입력 라벨, 탭" },
      "caption": { "$type": "typography", "$value": { "fontSize": 12, "lineHeight": 16, "fontWeight": "{primitive.fontWeight.regular}", "letterSpacing": 0 }, "$description": "날짜, 법적 고지. 12pt 미만 금지" },
      "button": { "$type": "typography", "$value": { "fontSize": 16, "lineHeight": 24, "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": 0 } }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": 6, "$description": "배지, 칩" },
      "md": { "$type": "dimension", "$value": 10, "$description": "입력 필드, 버튼 (RNR 기본)" },
      "lg": { "$type": "dimension", "$value": 14, "$description": "다이얼로그, 목록 그룹" },
      "xl": { "$type": "dimension", "$value": 20, "$description": "카드, 바텀시트" },
      "2xl": { "$type": "dimension", "$value": 24 },
      "3xl": { "$type": "dimension", "$value": 32 },
      "full": { "$type": "dimension", "$value": 9999 }
    },
    "size": {
      "touch": { "$type": "dimension", "$value": 44, "$description": "최소 터치 타깃" },
      "button-lg": { "$type": "dimension", "$value": 56, "$description": "주요 CTA 높이" },
      "button-md": { "$type": "dimension", "$value": 48 },
      "input": { "$type": "dimension", "$value": 52 },
      "icon": { "$type": "dimension", "$value": 24 },
      "icon-sm": { "$type": "dimension", "$value": 20 }
    },
    "motion": {
      "duration-fast": { "$type": "duration", "$value": 150 },
      "duration-base": { "$type": "duration", "$value": 220 },
      "duration-slow": { "$type": "duration", "$value": 320 }
    }
  }
}
